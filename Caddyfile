(app_proxy) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /healthz {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

http://localhost {
	import app_proxy
}

{$DOMAIN} {
	import app_proxy
}

api2.bfsmlt.top {
	encode zstd gzip
	reverse_proxy cli-proxy-api:8317
}
